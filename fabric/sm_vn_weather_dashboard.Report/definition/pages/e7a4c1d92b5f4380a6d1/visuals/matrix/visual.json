{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "matrix",
  "position": {
    "x": 540,
    "y": 450,
    "width": 700,
    "height": 590,
    "z": 15,
    "tabOrder": 15
  },
  "visual": {
    "visualType": "pivotTable",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_city"
                    }
                  },
                  "Property": "city_name"
                }
              },
              "queryRef": "dim_city.city_name",
              "nativeQueryRef": "city_name",
              "active": true
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_name"
                }
              },
              "queryRef": "dim_date.month_name",
              "nativeQueryRef": "month_name",
              "active": true
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_weather_daily"
                    }
                  },
                  "Property": "Pct Days Above Threshold"
                }
              },
              "queryRef": "fact_weather_daily.Pct Days Above Threshold",
              "nativeQueryRef": "Pct Days Above Threshold"
            }
          ]
        }
      }
    },
    "objects": {
      "values": [
        {
          "properties": {
            "backColor": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "fact_weather_daily"
                            }
                          },
                          "Property": "Pct Days Above Threshold"
                        }
                      },
                      "FillRule": {
                        "linearGradient2": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#E8A55F'"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#8E2410'"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'asZero'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 0
                }
              }
            ],
            "metadata": "fact_weather_daily.Pct Days Above Threshold"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Share of days above the WHO guideline, by city and month'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
}