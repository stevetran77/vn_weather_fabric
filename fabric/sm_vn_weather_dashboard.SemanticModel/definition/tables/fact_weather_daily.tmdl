table fact_weather_daily
	lineageTag: ac723c76-6a8e-4baf-987c-e8055cf59751
	sourceLineageTag: 4cced7cf-ce08-4b62-9c1e-57c61e0fc6f4

	/// Mean of the daily mean Model PM2.5 (ug/m3) in the current filter context. Model data (CAMS, about 45 km), not a station measurement.
	measure 'Avg PM2.5' = EXTERNALMEASURE("Avg PM2.5", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.0
		lineageTag: 1725db09-bed8-4eb3-afb6-668a3a4e162c
		sourceLineageTag: c4e439d8-a8d9-4bd5-8b73-7da8f02be81d
		dataCategory: Uncategorized

	/// Number of city-days (one City on one local day) whose mean Model PM2.5 is above the threshold set in nb_daily_aggregate (the pm2_5_threshold parameter; default is the WHO 24-hour guideline). Shows 0, not blank, when no day is above it.
	measure 'City-Days Above PM2.5 Threshold' = EXTERNALMEASURE("City-Days Above PM2.5 Threshold", INTEGER, "DirectQuery to AS - sm_vn_weather")
		formatString: #,0
		lineageTag: 7055dad5-254b-48da-af02-9640caf314f8
		sourceLineageTag: b1cfb611-7074-4c9f-8d7d-1a9f0a0ac32e
		dataCategory: Uncategorized

	/// Number of city-days that have a PM2.5 value (the denominator of the share below).
	measure 'Days With PM2.5' = EXTERNALMEASURE("Days With PM2.5", INTEGER, "DirectQuery to AS - sm_vn_weather")
		formatString: #,0
		lineageTag: 080942c4-6235-42f4-8e3a-9ee9c5d62494
		sourceLineageTag: b7d19b5e-70dd-465e-9091-e47d8e8311f7
		dataCategory: Uncategorized

	/// Share of city-days with a PM2.5 value that are above the threshold.
	measure 'Pct Days Above Threshold' = EXTERNALMEASURE("Pct Days Above Threshold", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.0%
		lineageTag: 3f27278e-5e83-403f-9c53-c6c2e2c3cf1b
		sourceLineageTag: 565d4a73-5793-4eb7-8151-835a13002096
		dataCategory: Uncategorized

	/// Rolling 30-day mean of daily Model PM2.5, ending on the last date in the current filter context. It averages city-days, so a City with missing days weighs less, and near the start of the data the window holds fewer than 30 days.
	measure 'PM2.5 Rolling 30d' = EXTERNALMEASURE("PM2.5 Rolling 30d", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.0
		lineageTag: 22f8fa03-f8ba-4176-8ae5-26d988aa33cd
		sourceLineageTag: 4546938b-38c7-4dd6-8f0c-e9b12fc9d1ee
		dataCategory: Uncategorized

	/// Mean of the daily mean temperature (C) at 2 m, for the temperature vs PM2.5 visual.
	measure 'Avg Temperature' = EXTERNALMEASURE("Avg Temperature", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.0
		lineageTag: 346abcf4-40b1-4f67-900d-11740a409551
		sourceLineageTag: 6dc14a11-78ff-473c-a942-881775d625b1
		dataCategory: Uncategorized

	/// Mean daily rainfall (mm per day), for the rainfall vs PM2.5 visual.
	measure 'Avg Daily Rainfall' = EXTERNALMEASURE("Avg Daily Rainfall", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.0
		lineageTag: a02efec1-e02e-40c2-aacc-9ad536523827
		sourceLineageTag: 92ff258f-a022-4695-9c67-f3c81b9bd310
		dataCategory: Uncategorized

	/// When nb_daily_aggregate last rebuilt this table, in Vietnam time. The pipeline runs it after every data refresh.
	measure 'Last Refresh' = EXTERNALMEASURE("Last Refresh", DATETIME, "DirectQuery to AS - sm_vn_weather")
		formatString: dd mmm yyyy hh:nn
		lineageTag: cc533342-d818-429b-a681-399755662edd
		sourceLineageTag: 93fe6f9b-8b3c-45ac-91ec-323e4f6e0d7d
		dataCategory: Uncategorized

	/// Vietnam limit for the 24-hour mean of PM2.5 (ug/m3): 45, from Table 1 of QCVN 05:2023/BTNMT (applies from 1 Jan 2026; the limit was 50 before). The value is fixed here on purpose, so there is one place to change it, and it is applied to every date in the data, including those before 2026. The regulation is in ug/Nm3, the model in ug/m3.
	measure 'VN PM2.5 Threshold 24h' = EXTERNALMEASURE("VN PM2.5 Threshold 24h", INTEGER, "DirectQuery to AS - sm_vn_weather")
		formatString: 0
		displayFolder: Vietnam threshold
		lineageTag: 76be9f0b-124e-4a66-81bc-8faa6cb70240
		sourceLineageTag: 5b25c2af-214e-4ec3-856d-9cc7832b5550
		dataCategory: Uncategorized

	/// Number of city-days (one City on one local day) whose mean Model PM2.5 is above the Vietnam 24-hour limit in [VN PM2.5 Threshold 24h]. Shows 0, not blank, when no day is above it. Model data (CAMS, about 45 km), not a station measurement.
	measure 'City-Days Above VN Threshold' = EXTERNALMEASURE("City-Days Above VN Threshold", INTEGER, "DirectQuery to AS - sm_vn_weather")
		formatString: #,0
		displayFolder: Vietnam threshold
		lineageTag: 46a1934c-89e8-4178-8ff7-d2e6dc1c9fbd
		sourceLineageTag: 277f31f7-db57-4ce5-82de-a9eea89dc009
		dataCategory: Uncategorized

	/// Share of city-days with a PM2.5 value that are above the Vietnam 24-hour limit. Compare with Pct Days Above Threshold, which uses the notebook threshold (default 15, the WHO 24-hour guideline).
	measure 'Pct Days Above VN Threshold' = EXTERNALMEASURE("Pct Days Above VN Threshold", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.0%
		displayFolder: Vietnam threshold
		lineageTag: e43d5bc2-27a2-486f-8466-b3b48458d14e
		sourceLineageTag: cd553226-9e1c-4aec-a52e-96d0bde86f4f
		dataCategory: Uncategorized

	/// Reference year for the year-over-year cards: the year selected in the Year slicer, otherwise the latest year in the data.
	measure 'Ref Year' = EXTERNALMEASURE("Ref Year", INTEGER, "DirectQuery to AS - sm_vn_weather")
		formatString: 0
		displayFolder: Year over year
		lineageTag: b1fdb290-a42e-404c-b128-7a2609459c9c
		sourceLineageTag: f8afa105-7562-4222-9a14-9d6abc65bb6e
		dataCategory: Uncategorized

	/// The year before [Ref Year].
	measure 'Prev Year' = EXTERNALMEASURE("Prev Year", INTEGER, "DirectQuery to AS - sm_vn_weather")
		formatString: 0
		displayFolder: Year over year
		lineageTag: 9d488a30-dd8b-4b9f-9821-fd613f9a81ef
		sourceLineageTag: e3afd06f-fa61-4d84-9123-452c8583d4cb
		dataCategory: Uncategorized

	/// Avg PM2.5 in the reference year minus Avg PM2.5 in the previous year, over the same months of the year (so a partial current year is compared like for like).
	measure 'PM2.5 Change vs Prev Year' = EXTERNALMEASURE("PM2.5 Change vs Prev Year", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: +0.0;-0.0;0.0
		displayFolder: Year over year
		lineageTag: 1ae3b0a2-b13c-4d63-9170-dbd6e47c01d2
		sourceLineageTag: db03dd14-3119-4a3f-bdc9-554ddf491249
		dataCategory: Uncategorized

	/// Change in the share of days above the WHO guideline, in percentage points, reference year vs previous year over the same months.
	measure 'Pct Above Change vs Prev Year (pp)' = EXTERNALMEASURE("Pct Above Change vs Prev Year (pp)", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: +0.0\ "pp";-0.0\ "pp";0.0\ "pp"
		displayFolder: Year over year
		lineageTag: f9914077-3791-46e6-8e1e-3aba87919fb9
		sourceLineageTag: d2c6b6fc-f040-451d-a295-71254c542cd7
		dataCategory: Uncategorized

	/// Change in mean daily rainfall (mm per day), reference year vs previous year over the same months.
	measure 'Rainfall Change vs Prev Year' = EXTERNALMEASURE("Rainfall Change vs Prev Year", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: +0.0;-0.0;0.0
		displayFolder: Year over year
		lineageTag: 746881bb-22a8-48e8-9f8f-6b88854df48d
		sourceLineageTag: 4db148ae-e2b6-4d6c-b2d9-eff0a7599c62
		dataCategory: Uncategorized

	/// Text for the Avg PM2.5 card: arrow, change in ug/m3 and the year compared with.
	measure 'PM2.5 Change Text' = EXTERNALMEASURE("PM2.5 Change Text", STRING, "DirectQuery to AS - sm_vn_weather")
		displayFolder: Year over year
		lineageTag: c67912e0-cdab-44ec-97b2-fa039223dde9
		sourceLineageTag: f52d0356-7f57-4773-b366-cda7fa6eb35f
		dataCategory: Uncategorized

	/// Font colour for the PM2.5 change text: red when PM2.5 rose, green when it fell (lower is better), grey otherwise.
	measure 'PM2.5 Change Color' = EXTERNALMEASURE("PM2.5 Change Color", STRING, "DirectQuery to AS - sm_vn_weather")
		displayFolder: Year over year
		lineageTag: 40692c13-5270-474f-a221-114d5d7b67ce
		sourceLineageTag: 2cdf4d66-d54f-427d-a765-0d6fb2a210db
		dataCategory: Uncategorized

	/// Pearson correlation between mean daily rainfall and Avg PM2.5, one point per City and month, for the current filters. A pattern to investigate, not a cause.
	measure 'r Rainfall vs PM2.5 (City-Months)' = EXTERNALMEASURE("r Rainfall vs PM2.5 (City-Months)", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.00
		displayFolder: Year over year
		lineageTag: e535d587-120c-42f8-9e01-d9529e42a4ea
		sourceLineageTag: 0ccfedb7-b283-4f01-bd33-0efed68b6673
		dataCategory: Uncategorized

	/// Pearson correlation between mean daily rainfall and Avg PM2.5, one point per City, for the current filters.
	measure 'r Rainfall vs PM2.5 (Across Cities)' = EXTERNALMEASURE("r Rainfall vs PM2.5 (Across Cities)", DOUBLE, "DirectQuery to AS - sm_vn_weather")
		formatString: 0.00
		displayFolder: Year over year
		lineageTag: 5bb45f29-e8c5-45f5-bc41-515498e625c1
		sourceLineageTag: 568a69fb-a8e4-43d6-826b-6c0371623a3d
		dataCategory: Uncategorized

