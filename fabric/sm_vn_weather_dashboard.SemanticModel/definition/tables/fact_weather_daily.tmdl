		sourceColumn: pm2_5_hours_count

		annotation SummarizationSetBy = User

	column is_above_pm2_5_threshold
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 322265f8-bd82-4b78-a051-41406c67db62
