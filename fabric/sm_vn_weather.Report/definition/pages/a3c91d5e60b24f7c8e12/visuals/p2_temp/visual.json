{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "p2_temp",
  "position": {
    "x": 40,
    "y": 200,
    "width": 900,
    "height": 540,
    "z": 3,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "scatterChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_city"
                    }
                  },
                  "Property": "city_name"
                }
              },
              "queryRef": "dim_city.city_name",
              "nativeQueryRef": "city_name",
              "active": true
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_weather_daily"
                    }
                  },
                  "Property": "Avg Temperature"
                }
              },
              "queryRef": "fact_weather_daily.Avg Temperature",
              "nativeQueryRef": "Avg Temperature"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_weather_daily"
                    }
                  },
                  "Property": "Avg PM2.5"
                }
              },
              "queryRef": "fact_weather_daily.Avg PM2.5",
              "nativeQueryRef": "Avg PM2.5"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Avg temperature (C) vs average Model PM2.5, per City'"
                }
              }
            }
          }
        }
      ]
    }
  }
}