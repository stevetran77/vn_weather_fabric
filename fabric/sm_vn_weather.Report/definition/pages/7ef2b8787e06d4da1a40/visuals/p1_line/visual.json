{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "p1_line",
  "position": {
    "x": 40,
    "y": 360,
    "width": 1000,
    "height": 680,
    "z": 3,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "dim_date.year",
              "nativeQueryRef": "year",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "season"
                }
              },
              "queryRef": "dim_date.season",
              "nativeQueryRef": "season"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_weather_daily"
                    }
                  },
                  "Property": "Avg PM2.5"
                }
              },
              "queryRef": "fact_weather_daily.Avg PM2.5",
              "nativeQueryRef": "Avg PM2.5"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Average Model PM2.5 by year and season (ug/m3)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}