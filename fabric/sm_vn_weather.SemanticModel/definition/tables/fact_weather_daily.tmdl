table fact_weather_daily
	lineageTag: 4cced7cf-ce08-4b62-9c1e-57c61e0fc6f4
	sourceLineageTag: [dbo].[fact_weather_daily]

	/// Mean of the daily mean Model PM2.5 (ug/m3) in the current filter context. Model data (CAMS, about 45 km), not a station measurement.
	measure 'Avg PM2.5' =
			AVERAGE ( fact_weather_daily[avg_pm2_5] )
		formatString: 0.0
		lineageTag: c4e439d8-a8d9-4bd5-8b73-7da8f02be81d

	/// Number of city-days (one City on one local day) whose mean Model PM2.5 is above the threshold set in nb_daily_aggregate (the pm2_5_threshold parameter; default is the WHO 24-hour guideline). Shows 0, not blank, when no day is above it.
	measure 'City-Days Above PM2.5 Threshold' =
			CALCULATE ( COUNTROWS ( fact_weather_daily ), fact_weather_daily[is_above_pm2_5_threshold] = TRUE () ) + 0
		formatString: #,0
		lineageTag: b1cfb611-7074-4c9f-8d7d-1a9f0a0ac32e

	/// Number of city-days that have a PM2.5 value (the denominator of the share below).
	measure 'Days With PM2.5' =
			CALCULATE ( COUNTROWS ( fact_weather_daily ), NOT ISBLANK ( fact_weather_daily[avg_pm2_5] ) )
		formatString: #,0
		lineageTag: b7d19b5e-70dd-465e-9091-e47d8e8311f7

	/// Share of city-days with a PM2.5 value that are above the threshold.
	measure 'Pct Days Above Threshold' =
			DIVIDE ( [City-Days Above PM2.5 Threshold], [Days With PM2.5] )
		formatString: 0.0%
		lineageTag: 565d4a73-5793-4eb7-8151-835a13002096

	/// Rolling 30-day mean of daily Model PM2.5, ending on the last date in the current filter context. It averages city-days, so a City with missing days weighs less, and near the start of the data the window holds fewer than 30 days.
	measure 'PM2.5 Rolling 30d' =
			CALCULATE ( [Avg PM2.5], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -30, DAY ) )
		formatString: 0.0
		lineageTag: 4546938b-38c7-4dd6-8f0c-e9b12fc9d1ee

	/// Mean of the daily mean temperature (C) at 2 m, for the temperature vs PM2.5 visual.
	measure 'Avg Temperature' =
			AVERAGE ( fact_weather_daily[avg_temperature_2m] )
		formatString: 0.0
		lineageTag: 6dc14a11-78ff-473c-a942-881775d625b1

	/// Mean daily rainfall (mm per day), for the rainfall vs PM2.5 visual.
	measure 'Avg Daily Rainfall' =
			AVERAGE ( fact_weather_daily[total_precipitation] )
		formatString: 0.0
		lineageTag: 92ff258f-a022-4695-9c67-f3c81b9bd310

	/// When nb_daily_aggregate last rebuilt this table, in Vietnam time. The pipeline runs it after every data refresh.
	measure 'Last Refresh' =
			MAX ( fact_weather_daily[refreshed_at] )
		formatString: dd mmm yyyy hh:mm
		lineageTag: 93fe6f9b-8b3c-45ac-91ec-323e4f6e0d7d

	/// Vietnam limit for the 24-hour mean of PM2.5 (ug/m3): 45, from Table 1 of QCVN 05:2023/BTNMT (applies from 1 Jan 2026; the limit was 50 before). The value is fixed here on purpose, so there is one place to change it, and it is applied to every date in the data, including those before 2026. The regulation is in ug/Nm3, the model in ug/m3.
	measure 'VN PM2.5 Threshold 24h' = 45
		formatString: 0
		displayFolder: Vietnam threshold
		lineageTag: 5b25c2af-214e-4ec3-856d-9cc7832b5550

	/// Number of city-days (one City on one local day) whose mean Model PM2.5 is above the Vietnam 24-hour limit in [VN PM2.5 Threshold 24h]. Shows 0, not blank, when no day is above it. Model data (CAMS, about 45 km), not a station measurement.
	measure 'City-Days Above VN Threshold' =
			VAR thr = [VN PM2.5 Threshold 24h]
			RETURN
				CALCULATE ( COUNTROWS ( fact_weather_daily ), KEEPFILTERS ( fact_weather_daily[avg_pm2_5] > thr ) ) + 0
		formatString: #,0
		displayFolder: Vietnam threshold
		lineageTag: 277f31f7-db57-4ce5-82de-a9eea89dc009

	/// Share of city-days with a PM2.5 value that are above the Vietnam 24-hour limit. Compare with Pct Days Above Threshold, which uses the notebook threshold (default 15, the WHO 24-hour guideline).
	measure 'Pct Days Above VN Threshold' =
			DIVIDE ( [City-Days Above VN Threshold], [Days With PM2.5] )
		formatString: 0.0%
		displayFolder: Vietnam threshold
		lineageTag: cd553226-9e1c-4aec-a52e-96d0bde86f4f

	/// Reference year for the year-over-year cards: the year selected in the Year slicer, otherwise the latest year in the data.
	measure 'Ref Year' =
			IF (
			    HASONEVALUE ( dim_date[year] ),
			    SELECTEDVALUE ( dim_date[year] ),
			    CALCULATE ( MAX ( dim_date[year] ), ALL ( dim_date ) )
			)
		formatString: 0
		displayFolder: Year over year
		lineageTag: f8afa105-7562-4222-9a14-9d6abc65bb6e

	/// The year before [Ref Year].
	measure 'Prev Year' =
			[Ref Year] - 1
		formatString: 0
		displayFolder: Year over year
		lineageTag: e3afd06f-fa61-4d84-9123-452c8583d4cb

	/// Avg PM2.5 in the reference year minus Avg PM2.5 in the previous year, over the same months of the year (so a partial current year is compared like for like).
	measure 'PM2.5 Change vs Prev Year' =
			VAR ref = [Ref Year]
			VAR ms = CALCULATETABLE ( VALUES ( dim_date[month] ), dim_date[year] = ref )
			VAR cur = CALCULATE ( [Avg PM2.5], dim_date[year] = ref )
			VAR prv = CALCULATE ( [Avg PM2.5], dim_date[year] = ref - 1, KEEPFILTERS ( ms ) )
			RETURN
			    IF ( ISBLANK ( cur ) || ISBLANK ( prv ), BLANK (), ( cur - prv ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: Year over year
		lineageTag: db03dd14-3119-4a3f-bdc9-554ddf491249

	/// Change in the share of days above the WHO guideline, in percentage points, reference year vs previous year over the same months.
	measure 'Pct Above Change vs Prev Year (pp)' =
			VAR ref = [Ref Year]
			VAR ms = CALCULATETABLE ( VALUES ( dim_date[month] ), dim_date[year] = ref )
			VAR cur = CALCULATE ( [Pct Days Above Threshold], dim_date[year] = ref )
			VAR prv = CALCULATE ( [Pct Days Above Threshold], dim_date[year] = ref - 1, KEEPFILTERS ( ms ) )
			RETURN
			    IF ( ISBLANK ( cur ) || ISBLANK ( prv ), BLANK (), ( cur - prv ) * 100 )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Year over year
		lineageTag: d2c6b6fc-f040-451d-a295-71254c542cd7

	/// Change in mean daily rainfall (mm per day), reference year vs previous year over the same months.
	measure 'Rainfall Change vs Prev Year' =
			VAR ref = [Ref Year]
			VAR ms = CALCULATETABLE ( VALUES ( dim_date[month] ), dim_date[year] = ref )
			VAR cur = CALCULATE ( [Avg Daily Rainfall], dim_date[year] = ref )
			VAR prv = CALCULATE ( [Avg Daily Rainfall], dim_date[year] = ref - 1, KEEPFILTERS ( ms ) )
			RETURN
			    IF ( ISBLANK ( cur ) || ISBLANK ( prv ), BLANK (), ( cur - prv ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: Year over year
		lineageTag: 4db148ae-e2b6-4d6c-b2d9-eff0a7599c62

	/// Text for the Avg PM2.5 card: arrow, change in ug/m3 and the year compared with.
	measure 'PM2.5 Change Text' =
			VAR d = [PM2.5 Change vs Prev Year]
			RETURN
			    IF (
			        ISBLANK ( d ),
			        "no previous year",
			        IF ( d > 0, "UP ", IF ( d < 0, "DOWN ", "" ) ) & FORMAT ( d, "+0.0;-0.0;0.0" ) & " ug/m3 vs " & [Prev Year]
			    )
		displayFolder: Year over year
		lineageTag: f52d0356-7f57-4773-b366-cda7fa6eb35f

	/// Font colour for the PM2.5 change text: red when PM2.5 rose, green when it fell (lower is better), grey otherwise.
	measure 'PM2.5 Change Color' =
			IF ( [PM2.5 Change vs Prev Year] > 0, "#C0392B", IF ( [PM2.5 Change vs Prev Year] < 0, "#2E7D32", "#6B6B6B" ) )
		displayFolder: Year over year
		lineageTag: 2cdf4d66-d54f-427d-a765-0d6fb2a210db

	/// Pearson correlation between mean daily rainfall and Avg PM2.5, one point per City and month, for the current filters. A pattern to investigate, not a cause.
	measure 'r Rainfall vs PM2.5 (City-Months)' =
			VAR t =
			    FILTER (
			        ADDCOLUMNS ( SUMMARIZE ( fact_weather_daily, dim_city[city_name], dim_date[year], dim_date[month] ), "@x", [Avg Daily Rainfall], "@y", [Avg PM2.5] ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( t, [@x] )
			VAR my = AVERAGEX ( t, [@y] )
			VAR sxy = SUMX ( t, ( [@x] - mx ) * ( [@y] - my ) )
			VAR sxx = SUMX ( t, ( [@x] - mx ) ^ 2 )
			VAR syy = SUMX ( t, ( [@y] - my ) ^ 2 )
			RETURN
			    IF ( COUNTROWS ( t ) < 3, BLANK (), DIVIDE ( sxy, SQRT ( sxx * syy ) ) )
		formatString: 0.00
		displayFolder: Year over year
		lineageTag: 0ccfedb7-b283-4f01-bd33-0efed68b6673

	/// Pearson correlation between mean daily rainfall and Avg PM2.5, one point per City, for the current filters.
	measure 'r Rainfall vs PM2.5 (Across Cities)' =
			VAR t =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_city[city_name] ), "@x", [Avg Daily Rainfall], "@y", [Avg PM2.5] ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( t, [@x] )
			VAR my = AVERAGEX ( t, [@y] )
			VAR sxy = SUMX ( t, ( [@x] - mx ) * ( [@y] - my ) )
			VAR sxx = SUMX ( t, ( [@x] - mx ) ^ 2 )
			VAR syy = SUMX ( t, ( [@y] - my ) ^ 2 )
			RETURN
			    IF ( COUNTROWS ( t ) < 3, BLANK (), DIVIDE ( sxy, SQRT ( sxx * syy ) ) )
		formatString: 0.00
		displayFolder: Year over year
		lineageTag: 568a69fb-a8e4-43d6-826b-6c0371623a3d

