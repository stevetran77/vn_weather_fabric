# Copy to legacy_source/.env (gitignored) and fill in the values. Never commit real values.
# SA_PASSWORD: password of the SQL Server sa account (needs upper, lower, digit, symbol; 8+ chars)
SA_PASSWORD=
# READER_PASSWORD: password of the read-only login fabric_reader (used by init_legacy_db.sql)
READER_PASSWORD=
# WRITER_PASSWORD: password of the login fabric_loader (can write; used by the seed pipeline)
WRITER_PASSWORD=
# BIND_IP: Mac address on the Fusion NAT network, as seen from the VM
# (find it with: ifconfig | grep -A3 bridge). It can change after restarting Fusion.
BIND_IP=
